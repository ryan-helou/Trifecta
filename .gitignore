# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.build-aside/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# iOS self-test artifacts (screenshots, junit)
artifacts/

# inlined webfonts cached by scripts/gen-store-frames.mjs (re-fetched on demand)
.cache/

# transient snapshot copy used to run a capture without live-editing the original
scripts/.capture-run.tmp.sh

# Seeded test state written into public/ so the WebView can fetch it during a
# simulator run. public/ is copied verbatim into the static export, so committing one
# would ship a fabricated account and its whole plan to every device.
public/__seed*.json
.claude/
CLAUDE.md
AGENTS.md
