# Trifecta iOS — fastlane
#
# Path-A TestFlight loop, headless (no Xcode GUI, no Apple ID/2FA):
#   fastlane build     # archive Release → signed IPA (auto-registers bundle ID + dist cert via API key)
#   fastlane upload    # upload the built IPA to TestFlight internal (needs the ASC app record to exist)
#   fastlane beta      # build + upload in one shot (once the app record exists)
#
# NOTE: creating the App Store Connect *app record* is a one-time web-UI step —
# Apple's API key can't create it (`produce` needs Apple-ID/2FA). Everything else
# below uses the API key.
#
# Auth: App Store Connect API key. The .p8 (the ONLY secret) lives OUTSIDE the repo
# at ~/.appstoreconnect/private_keys/. Key ID + Issuer ID are non-secret identifiers.

default_platform(:ios)

API_KEY_ID    = "PZ5T3D2T7A"
API_ISSUER_ID = "a2009c5b-786e-42e7-a600-c9af7e854559"
API_KEY_PATH  = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_PZ5T3D2T7A.p8")

def asc_key
  app_store_connect_api_key(
    key_id: API_KEY_ID,
    issuer_id: API_ISSUER_ID,
    key_filepath: API_KEY_PATH,
    in_house: false
  )
end

# Passed to the ARCHIVE xcodebuild invocation so development signing can auto-update.
SIGN_XCARGS = "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{API_KEY_PATH} " \
              "-authenticationKeyID #{API_KEY_ID} " \
              "-authenticationKeyIssuerID #{API_ISSUER_ID}"

TEAM_ID = "9QX2835W83"

# Manual signing for the EXPORT step — uses the distribution cert + App Store profile
# created explicitly via the API key (cert / get_provisioning_profile), avoiding the
# in-export cloud-signing path which throws "Cloud signing permission error".
EXPORT_OPTS = {
  signingStyle: "manual",
  teamID: TEAM_ID,
  signingCertificate: "Apple Distribution",
  provisioningProfiles: { "app.trifecta.mobile" => "app.trifecta.mobile AppStore" }
}

platform :ios do
  desc "Archive (Release) → signed IPA. Auto-registers the bundle ID + creates the distribution cert/profile via the API key."
  lane :build do
    asc_key # registers the key in lane context so xcodebuild -allowProvisioningUpdates can authenticate
    # Auto-increment the build number past the latest one on TestFlight (Apple rejects
    # duplicates). Passed via xcargs so no project.pbxproj edit / git churn.
    next_build = latest_testflight_build_number(
      api_key: asc_key,
      app_identifier: "app.trifecta.mobile",
      initial_build_number: 1
    ) + 1
    UI.message("Building with build number #{next_build}")
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "#{SIGN_XCARGS} CURRENT_PROJECT_VERSION=#{next_build}",
      export_options: EXPORT_OPTS,
      output_directory: "build",
      output_name: "Trifecta.ipa",
      clean: true
    )
  end

  desc "Export an existing .xcarchive to a signed IPA (reuses ENV['ARCHIVE_PATH']). For fast signing iteration."
  lane :export_only do
    asc_key
    build_app(
      archive_path: ENV["ARCHIVE_PATH"],
      skip_build_archive: true,
      export_method: "app-store",
      export_options: EXPORT_OPTS,
      output_directory: "build",
      output_name: "Trifecta.ipa"
    )
  end

  desc "Diagnostic: try to create/fetch an Apple Distribution certificate via the API key."
  lane :diag_cert do
    cert(
      api_key: asc_key,
      output_path: "build/certs"
    )
  end

  desc "Register the App ID (bundle identifier) via the App Store Connect API (one-time)."
  lane :register_bundle_id do
    asc_key # sets Spaceship::ConnectAPI token
    existing = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == "app.trifecta.mobile" }
    if existing
      UI.success("Bundle ID already registered: #{existing.identifier} (#{existing.id})")
    else
      bid = Spaceship::ConnectAPI::BundleId.create(
        name: "Trifecta",
        identifier: "app.trifecta.mobile",
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS
      )
      UI.success("Registered bundle ID: #{bid.identifier} (#{bid.id})")
    end
  end

  desc "Diagnostic: create the App Store provisioning profile for app.trifecta.mobile via the API key."
  lane :make_profile do
    get_provisioning_profile(
      api_key: asc_key,
      app_identifier: "app.trifecta.mobile",
      output_path: "build/profiles"
    )
  end

  desc "Upload the built IPA to TestFlight (internal). Requires the ASC app record to exist."
  lane :upload do
    # WAIT for processing, then distribute to the internal group.
    #
    # `skip_waiting_for_build_processing: true` returns the moment the binary is
    # accepted, which is fast and looks fine — the build appears in App Store Connect
    # and processes to VALID. But fastlane never gets to the TestFlight side, so the
    # build can end up with no buildBetaDetail, no preReleaseVersion and no group.
    # Builds 10, 11 and 12 all landed that way on 2026-07-29: VALID for the App Store,
    # invisible in TestFlight, and the API refuses to add them to a group ("there is no
    # resource of type 'builds'") because TestFlight never ingested them.
    #
    # Waiting costs a few minutes per ship and buys a build a human can actually install
    # — which is the entire point of uploading to TestFlight.
    upload_to_testflight(
      api_key: asc_key,
      ipa: "build/Trifecta.ipa",
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      groups: ["Me"],
      changelog: "Internal build — see the commit log on main.",
      notify_external_testers: false
    )
  end

  desc "Build + upload in one shot (use once the app record exists)."
  lane :beta do
    build
    upload
  end

  desc "Add an internal TestFlight tester by email. Usage: fastlane add_tester email:foo@bar.com name:'First Last'"
  lane :add_tester do |opts|
    asc_key
    email = opts[:email] || UI.user_error!("pass email:you@example.com")
    parts = (opts[:name] || "").strip.split(" ", 2)
    first = (parts[0] && !parts[0].empty?) ? parts[0] : email.split("@").first
    last  = parts[1] || "Tester"

    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    group = app.get_beta_groups.find(&:is_internal_group) || UI.user_error!("no internal group found")
    UI.message("internal group '#{group.name}' (#{group.id})")

    existing = (Spaceship::ConnectAPI::BetaTester.find(email: email) rescue nil)
    if existing
      Spaceship::ConnectAPI.add_beta_tester_to_group(beta_group_id: group.id, beta_tester_ids: [existing.id])
      UI.success("Attached existing tester #{email} to '#{group.name}'")
    else
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [group.id],
        attributes: { email: email, firstName: first, lastName: last }
      )
      UI.success("Created + assigned tester #{email} to '#{group.name}'")
    end
  end

  desc "Add Ryan (ryan.helou@gmail.com) as an internal tester on the latest build."
  lane :invite_me do
    add_tester(email: "ryan.helou@gmail.com", name: "Ryan Helou")
  end

  desc "Show a tester's current group/app assignments. Usage: fastlane tester_status email:foo@bar.com"
  lane :tester_status do |opts|
    asc_key
    email = opts[:email] || "ryan.helou@gmail.com"
    t = (Spaceship::ConnectAPI::BetaTester.find(email: email, includes: "betaGroups,apps") rescue nil)
    if t.nil?
      UI.important("No tester record for #{email}")
    else
      groups = (t.beta_groups || []).map { |g| "#{g.name}(internal=#{g.is_internal_group})" }
      apps = (t.apps || []).map { |a| a.bundle_id }
      UI.success("tester #{email} id=#{t.id} state=#{t.state.inspect} groups=#{groups.inspect} apps=#{apps.inspect}")
    end
  end

  # ---- App Store listing / submission (via the ASC API key; no Apple-ID/2FA) ----

  desc "Diagnostic: dump the editable App Store version state + submission gates."
  lane :asc_status do
    asc_key
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    UI.success("App: #{app.name} (#{app.id})")
    v = (app.get_edit_app_store_version rescue nil)
    if v
      UI.message("editable version #{v.version_string} state=#{v.app_store_state}")
      b = (v.get_build rescue nil)
      UI.message("  build attached: #{b ? b.version : 'NONE'}")
    else
      UI.important("no editable version (Prepare for Submission) found")
    end
    (app.get_app_infos rescue []).each do |ai|
      pc = (ai.primary_category rescue nil); sc = (ai.secondary_category rescue nil)
      UI.message("appInfo state=#{ai.app_store_state rescue '?'} primary=#{pc && pc.id} secondary=#{sc && sc.id}")
    end
  end

  desc "Create the App Store review detail (Apple's demo login + contact) — also fixes deliver's first-version 'No data' crash on fetch_app_store_review_detail."
  # The notes App Review reads before they open the app. The repo is the source of
  # truth for this text, not the web form, so it can't silently drift.
  #
  # 1.0 (8) was rejected under guideline 2.5.1 — HealthKit entitlement shipped, no
  # HealthKit functionality the reviewer could find in the UI. The old version of
  # these notes made that worse: its last line said Apple Health "is optional and not
  # needed to review core features", which is an instruction not to go looking. Now
  # the notes name the exact tab, the exact section heading, and what the screen says.
  REVIEW_NOTES = <<~NOTES.strip
    Triathlon training app. Sign in with the demo account above — it has a fully populated IRONMAN 70.3 plan (Today / Plan / Progress / Friends / Profile).

    WHERE THE HEALTHKIT FUNCTIONALITY IS (re: guideline 2.5.1)

    Tap "Profile" in the bottom tab bar. The section headed "APPLE HEALTH" is visible there without scrolling. It reads:

      Auto-complete from Apple Health
      Reads your swim, bike, run and strength workouts and checks off the planned session each one matches.
      • Read-only — Trifecta never writes to Apple Health.
      • Stays on your device — nothing from Health is uploaded.
      [ Sync with Apple Health ]

    Tapping "Sync with Apple Health" triggers the HealthKit read-authorization prompt, then reads recent workouts and marks the matching planned sessions done.

    In the previously reviewed build this section was rendered inside the Strava card and could fail to appear. That is fixed in this build, and an automated UI test now asserts the section is present on the Profile tab.

    The attached screenshot "profile-apple-health.png" shows this screen. It is captured on an iOS Simulator (iPhone 17) rather than a physical device, which we note for transparency.

    SCOPE OF HEALTHKIT USE

    Read-only access to workout samples only. Trifecta never writes to or modifies HealthKit. Workouts are matched to the training plan on-device; health data is not uploaded to our server and is not used for advertising.
  NOTES

  lane :store_reviewinfo do |opts|
    asc_key
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    version = app.get_edit_app_store_version
    UI.user_error!("no editable App Store version") if version.nil?
    attrs = {
      contactFirstName: "Ryan",
      contactLastName: "Helou",
      contactPhone: opts[:phone] || "+1 000 000 0000",
      contactEmail: "ryan.helou@gmail.com",
      demoAccountRequired: true,
      demoAccountName: "trifectademo",
      demoAccountPassword: "demopass123",
      notes: REVIEW_NOTES
    }
    existing = (version.fetch_app_store_review_detail rescue nil)
    if existing
      # Idempotent on purpose: this lane used to bail out with "already exists" and
      # leave stale notes in place, which is how the misleading Apple Health line
      # survived into the review that cited us for it.
      Spaceship::ConnectAPI.patch_app_store_review_detail(
        app_store_review_detail_id: existing.id, attributes: attrs
      )
      UI.success("updated review detail #{existing.id}")
    else
      d = version.create_app_store_review_detail(attributes: attrs)
      UI.success("created review detail #{d.id}")
    end
  end

  desc "Enable HealthKit on the App ID + regenerate the App Store profile. Fixes the entitlement mismatch that FAILED builds 2-5 in processing."
  lane :fix_healthkit do
    asc_key
    bid = Spaceship::ConnectAPI::BundleId.all(includes: "bundleIdCapabilities").find { |b| b.identifier == "app.trifecta.mobile" }
    has_hk = (bid.get_capabilities rescue []).any? { |c| (c.capability_type rescue "").to_s.include?("HEALTH") }
    if has_hk
      UI.success("HealthKit already enabled on the App ID")
    else
      Spaceship::ConnectAPI::BundleIdCapability.create(bundle_id_id: bid.id, capability_type: "HEALTHKIT")
      UI.success("enabled HEALTHKIT capability on App ID #{bid.identifier}")
    end
    # regenerate the App Store profile so the exported IPA carries the HealthKit entitlement
    get_provisioning_profile(
      api_key: asc_key,
      app_identifier: "app.trifecta.mobile",
      provisioning_name: "app.trifecta.mobile AppStore",
      force: true,
      output_path: "build/profiles"
    )
    UI.success("regenerated App Store provisioning profile (now includes HealthKit)")
  end

  desc "Set the age-rating declaration to a clean 4+ (all content descriptors NONE). No submit."
  lane :store_agerating do
    asc_key
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    decl = app.fetch_edit_app_info.fetch_age_rating_declaration
    decl.update(attributes: {
      "alcoholTobaccoOrDrugUseOrReferences" => "NONE",
      "contests" => "NONE",
      "gamblingSimulated" => "NONE",
      "gunsOrOtherWeapons" => "NONE",
      "horrorOrFearThemes" => "NONE",
      "matureOrSuggestiveThemes" => "NONE",
      "medicalOrTreatmentInformation" => "NONE",
      "profanityOrCrudeHumor" => "NONE",
      "sexualContentGraphicAndNudity" => "NONE",
      "sexualContentOrNudity" => "NONE",
      "violenceCartoonOrFantasy" => "NONE",
      "violenceRealistic" => "NONE",
      "violenceRealisticProlongedGraphicOrSadistic" => "NONE",
      "gambling" => false,
      "unrestrictedWebAccess" => false,
      "lootBox" => false,
      "advertising" => false,
      "messagingAndChat" => false,
      "parentalControls" => false,
      "userGeneratedContent" => false,
      "healthOrWellnessTopics" => false,
      "ageAssurance" => false,
      "kidsAgeBand" => nil
    })
    UI.success("age rating set → 4+ (all descriptors NONE)")
  end

  desc "Set App Store text metadata (name/subtitle/desc/keywords/urls) + category via Spaceship. Bypasses deliver's first-version review-detail crash. No submit."
  lane :store_text do
    asc_key
    md = File.join(__dir__, "metadata", "en-US")
    rd = ->(f) { p = File.join(md, f); File.exist?(p) ? File.read(p).strip : "" }
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")

    # version-level copy
    version = app.get_edit_app_store_version
    vlocs = version.get_app_store_version_localizations
    vloc = vlocs.find { |l| l.locale == "en-US" } || vlocs.first
    vattrs = {
      description: rd.call("description.txt"),
      keywords: rd.call("keywords.txt"),
      promotionalText: rd.call("promotional_text.txt"),
      supportUrl: rd.call("support_url.txt"),
      marketingUrl: rd.call("marketing_url.txt")
    }.reject { |_, v| v.to_s.empty? }
    vloc.update(attributes: vattrs)
    UI.success("version copy set (#{vloc.locale}): #{vattrs.keys.join(', ')}")

    # app-level copy (name / subtitle / privacy url)
    app_info = app.fetch_edit_app_info
    ilocs = app_info.get_app_info_localizations
    iloc = ilocs.find { |l| l.locale == "en-US" } || ilocs.first
    iattrs = {
      name: rd.call("name.txt"),
      subtitle: rd.call("subtitle.txt"),
      privacyPolicyUrl: rd.call("privacy_url.txt")
    }.reject { |_, v| v.to_s.empty? }
    iloc.update(attributes: iattrs)
    UI.success("app info copy set (#{iloc.locale}): #{iattrs.keys.join(', ')}")

    begin
      app_info.update_categories(category_id_map: { primary_category_id: "HEALTH_AND_FITNESS", secondary_category_id: "SPORTS" })
      UI.success("categories set: Health & Fitness / Sports")
    rescue => e
      UI.important("category set skipped: #{e.message}")
    end
  end

  desc "Upload ONLY screenshots via deliver (screenshot path doesn't hit the review-detail bug). No submit."
  # What this uploads are the MARKETING FRAMES in fastlane/screenshots/en-US — captioned,
  # device-framed artwork, not bare simulator captures. Regenerate them before uploading:
  #
  #   npm run store:shots      # capture on the sim, then wrap in frames
  #
  # Raw captures live one directory over in fastlane/screenshots-raw/ precisely so they
  # can't be picked up by deliver and shipped as-is.
  lane :store_shots do
    deliver(
      api_key: asc_key,
      app_identifier: "app.trifecta.mobile",
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  desc "Upload the App Store listing (metadata + screenshots). Does NOT submit. Idempotent."
  lane :store_meta do
    deliver(
      api_key: asc_key,
      app_identifier: "app.trifecta.mobile",
      force: true,                 # no interactive HTML preview
      skip_binary_upload: true,    # build already on TestFlight
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      primary_category: "HEALTH_AND_FITNESS",
      secondary_category: "SPORTS",
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Attach the latest VALID build to the editable version + answer export compliance (Spaceship, reliable)."
  lane :store_attach do
    asc_key
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10)
    UI.message("builds: " + builds.map { |b| "#{b.version}(#{b.processing_state})" }.join(", "))
    build = builds.find { |b| b.processing_state == "VALID" } || builds.find(&:processed?) || builds.first
    UI.user_error!("no build available to attach") unless build
    begin
      build.update(attributes: { usesNonExemptEncryption: false })
      UI.success("export compliance answered (uses no non-exempt encryption)")
    rescue => e
      UI.important("export-compliance set skipped: #{e.message}")
    end
    version = app.get_edit_app_store_version
    version.select_build(build_id: build.id)
    UI.success("attached build #{build.version} (#{build.processing_state}) to version #{version.version_string}")
  end

  desc "Poll until a SPECIFIC build number (default 5) finishes Apple processing (VALID), then attach it + answer export compliance. Usage: fastlane store_finish build:5"
  lane :store_finish do |opts|
    asc_key
    target = (opts[:build] || "5").to_s
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    build = nil
    90.times do |i|
      builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 8)
      b = builds.find { |x| x.version.to_s == target }
      st = b&.processing_state
      UI.message("poll #{i}: build ##{target} = #{st || 'not visible yet'}")
      if st == "VALID"
        build = b; break
      elsif %w[INVALID FAILED].include?(st)
        UI.user_error!("build ##{target} failed Apple processing: #{st}")
      end
      sleep(30)
    end
    UI.user_error!("build ##{target} did not become VALID within ~20 min") unless build
    begin
      build.update(attributes: { usesNonExemptEncryption: false })
      UI.success("export compliance answered")
    rescue => e
      UI.important("export compliance already set / skipped: #{e.message}")
    end
    version = app.get_edit_app_store_version
    version.select_build(build_id: build.id)
    UI.success("attached build ##{build.version} to version #{version.version_string}")
  end

  desc "Submit the editable version (with its already-attached build) for App Store review."
  lane :store_submit do
    deliver(
      api_key: asc_key,
      app_identifier: "app.trifecta.mobile",
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Where is the App Store submission right now? Read-only. Usage: fastlane review_status"
  lane :review_status do
    asc_key
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    UI.header("#{app.name} (#{app.id})")

    # --- versions + their review state -------------------------------------
    versions = (app.get_app_store_versions rescue [])
    if versions.empty?
      UI.important("no app store versions returned")
    end
    versions.first(5).each do |v|
      state = (v.app_store_state rescue nil) || (v.app_version_state rescue nil) || "?"
      rel   = (v.release_type rescue "?")
      b     = (v.get_build rescue nil)
      UI.message("version #{v.version_string}  state=#{state}  release=#{rel}  build=#{b ? b.version : 'NONE'}")
      UI.message("  created: #{v.created_date}") if (v.respond_to?(:created_date) && v.created_date)
    end

    # --- the review submission itself --------------------------------------
    subs = begin
      app.get_review_submissions(includes: "appStoreVersionForReview", limit: 5)
    rescue => e
      UI.error("get_review_submissions failed: #{e.message}")
      []
    end

    if subs.nil? || subs.empty?
      UI.important("no review submissions visible")
    else
      subs.first(5).each do |s|
        state     = (s.state rescue "?")
        submitted = (s.submitted_date rescue nil)
        line = "submission #{(s.id rescue '?')}  state=#{state}"
        if submitted
          t = (submitted.is_a?(String) ? Time.parse(submitted) : submitted)
          hours = ((Time.now - t) / 3600.0).round(1)
          line += "  submitted=#{t.utc.strftime('%Y-%m-%d %H:%M UTC')}  elapsed=#{hours}h (#{(hours / 24.0).round(1)}d)"
        end
        UI.success(line)
      end
    end

    # --- anything Apple is waiting on us for -------------------------------
    # NOTE: get_edit_app_store_version also returns WAITING_FOR_REVIEW versions
    # (Apple still lets you edit some fields in the queue), so only the
    # PREPARE_FOR_SUBMISSION state actually means "never submitted".
    begin
      v = (app.get_edit_app_store_version rescue nil)
      st = v && ((v.app_store_state rescue nil) || (v.app_version_state rescue nil))
      if st.to_s == "PREPARE_FOR_SUBMISSION"
        UI.error("version #{v.version_string} is PREPARE_FOR_SUBMISSION — it was never submitted!")
      else
        UI.message("nothing sitting unsubmitted (editable state=#{st || 'none'})")
      end
    rescue => e
      UI.important("edit-version check skipped: #{e.message}")
    end
  end

  desc "Update the App Review notes on the current version. Usage: fastlane store_notes text:'…'"
  lane :store_notes do |opts|
    asc_key
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    version = app.get_edit_app_store_version || UI.user_error!("no editable version")
    detail = version.fetch_app_store_review_detail || UI.user_error!("no review detail")
    text = opts[:text] || UI.user_error!("pass text:'…'")
    detail.update(attributes: { notes: text })
    UI.success("review notes updated (#{text.length} chars) on version #{version.version_string}")
  end

  desc "Cancel the in-progress/rejected review submission so a new build can be submitted."
  lane :store_cancel do
    asc_key
    app = Spaceship::ConnectAPI::App.find("app.trifecta.mobile")
    open = app.get_review_submissions(limit: 10).reject { |s| (s.state rescue nil) == "COMPLETE" }
    if open.empty?
      UI.success("no open review submission — nothing to cancel")
    else
      open.each do |s|
        UI.message("cancelling submission #{s.id} (state=#{s.state})")
        s.cancel_submission
      end
      # A cancelled submission keeps OWNING the version until it reaches COMPLETE.
      # Submitting before then fails with "A review submission is already in progress".
      40.times do |i|
        still = app.get_review_submissions(limit: 10).reject { |s| (s.state rescue nil) == "COMPLETE" }
        break UI.success("all submissions COMPLETE — version released") if still.empty?
        UI.message("poll #{i}: still open -> #{still.map { |s| s.state }.join(', ')}")
        sleep(10)
      end
    end
    v = (app.get_edit_app_store_version rescue nil)
    UI.success("editable version #{v&.version_string} state=#{v && (v.app_store_state rescue v.app_version_state)}")
  end
end
